{
  "name": "hegemarch",
  "private": true,
  "version": "1.22.0",
  "description": "Hegemarch: an 8-bit real-time space strategy roguelite. Light up a dark sector, world by world.",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build && node scripts/inline-build.mjs",
    "build:site": "vite build --config vite.site.config.ts",
    "package": "npm run build && npm run build:site && node scripts/package.mjs",
    "preview": "vite preview --open",
    "preview:site": "vite preview --outDir release/site --open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:ages": "tsx scripts/ages.ts",
    "balance:passive": "tsx scripts/passive.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:shots": "node scripts/shot.mjs",
    "test:perf": "node scripts/perf.mjs",
    "test:dist": "node scripts/smoke-dist.mjs",
    "test:gallery": "node scripts/gallery.mjs",
    "test:tutorial": "node scripts/tutorial.mjs",
    "test:audio": "node scripts/audio.mjs",
    "test:music": "node scripts/music.mjs",
    "test:menus": "node scripts/menus.mjs",
    "test:site": "node scripts/site.mjs",
    "test:ages": "node scripts/ages.mjs",
    "test:layouts": "node scripts/layouts.mjs",
    "test:stopped": "node scripts/stopped.mjs",
    "test:sound": "node scripts/sound.mjs",
    "test:howto": "node scripts/howto-look.mjs",
    "test:qol": "node scripts/qol.mjs",
    "test:starfall": "node scripts/starfall.mjs",
    "test:uifuzz": "node scripts/uifuzz.mjs",
    "test:fuzz": "tsx scripts/fuzz.ts",
    "golden": "tsx scripts/golden.ts",
    "test:uisnap": "node scripts/uisnap.mjs",
    "verify": "node scripts/verify.mjs",
    "record:ending": "node scripts/record-ending.mjs",
    "record:starfall": "node scripts/record-starfall.mjs",
    "record:draft": "node scripts/record-draft.mjs",
    "record:event": "node scripts/record-event.mjs",
    "record:ability": "node scripts/record-ability.mjs",
    "record:herald": "node scripts/record-herald.mjs",
    "record:omens": "node scripts/record-omens.mjs",
    "record:touches": "node scripts/record-touches.mjs",
    "favicon": "node scripts/favicon.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
